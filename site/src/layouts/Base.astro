---
import '../styles/global.css';
import '@fontsource/chakra-petch/500.css';
import '@fontsource/chakra-petch/600.css';
import '@fontsource/chakra-petch/700.css';
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/600.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import 'katex/dist/katex.min.css';

const { title, description = 'A study roadmap for Visual-SLAM: 11 levels, 400+ notes on the theory and the papers.', dark = false } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
  </head>
  <body class={dark ? 'blueprint min-h-screen text-slate-200 font-sans' : 'graph-paper min-h-screen text-inkline font-sans'}>
    <header class={dark
      ? 'border-b border-scan-500/20'
      : 'border-b border-paper-line bg-paper/90 backdrop-blur sticky top-0 z-10'}>
      <nav class="mx-auto max-w-5xl px-5 py-3 flex items-baseline gap-4">
        <a href={base} class={`font-display font-semibold tracking-wide text-sm uppercase ${dark ? 'text-scan-300' : 'text-scan-500'} hover:opacity-80`}>
          VSLAM<span class="opacity-60">//</span>Roadmap
        </a>
        <span class={`hidden sm:inline font-mono text-xs ${dark ? 'text-slate-500' : 'text-slate-400'}`}>changh95 / visual-slam-roadmap</span>
        <a href="https://github.com/changh95/visual-slam-roadmap" class={`ml-auto font-mono text-xs ${dark ? 'text-slate-400 hover:text-scan-300' : 'text-slate-500 hover:text-scan-500'}`}>GitHub &nearr;</a>
      </nav>
    </header>
    <slot />
    <footer class={`mx-auto max-w-5xl px-5 py-10 font-mono text-xs ${dark ? 'text-slate-500' : 'text-slate-400'}`}>
      MIT License &copy; 2026 Hyunggi Chang · built from the <a class="underline hover:no-underline" href="https://github.com/changh95/visual-slam-roadmap">roadmap repository</a>
    </footer>
  </body>
</html>
