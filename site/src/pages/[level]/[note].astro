---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getSections } from '../../lib/readme.mjs';
import { extractSummary, articleLd, breadcrumbLd } from '../../lib/seo.mjs';

export async function getStaticPaths() {
  const notes = await getCollection('notes');
  return notes.map((entry) => {
    const [level, note] = entry.id.split('/');
    return { params: { level, note }, props: { entry } };
  });
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const base = import.meta.env.BASE_URL;
const [levelDir] = entry.id.split('/');
const lv = getSections().levels.find((l) => l.dir === levelDir);
const title = (entry.body.match(/^# (.+)$/m) || [, entry.id])[1];
const desc = extractSummary(entry.body);
const path = `/${entry.id}/`;
const jsonld = [
  articleLd({ title, description: desc, path, lang: 'en' }),
  breadcrumbLd([
    ['Visual-SLAM Roadmap', '/'],
    ...(lv ? [[`Level ${lv.n}: ${lv.title}`, `/${lv.dir}/`]] : []),
    [title, path],
  ]),
];
---
<Base title={`${title} — Visual-SLAM Roadmap`} description={desc} ogType="article" jsonld={jsonld}>
  <main class="mx-auto max-w-3xl px-5 py-10">
    <nav class="font-mono text-xs text-slate-500 mb-6">
      <a class="text-scan-500 hover:underline" href={base}>roadmap</a>
      <span class="mx-1">/</span>
      {lv && <a class="text-scan-500 hover:underline" href={`${base}${lv.dir}/`}>level {String(lv.n).padStart(2, '0')} · {lv.title}</a>}
    </nav>
    <article class="prose prose-slate max-w-none prose-headings:font-display prose-a:text-scan-500 prose-a:decoration-scan-300/50 hover:prose-a:decoration-scan-500 prose-blockquote:font-mono prose-blockquote:text-sm prose-blockquote:not-italic bg-paper/80 border border-paper-line p-6 sm:p-8">
      <Content />
    </article>
  </main>
</Base>
