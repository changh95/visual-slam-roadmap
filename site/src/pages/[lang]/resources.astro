---
import Base from '../../layouts/Base.astro';
import { getSections, renderMd } from '../../lib/readme.mjs';
import { ALT_LANGS, getUi, getSectionMd } from '../../lib/i18n.mjs';

export function getStaticPaths() {
  return ALT_LANGS.map((lang) => ({ params: { lang } }));
}
const { lang } = Astro.params;
const ui = getUi(lang);
const { resources } = getSections();
const md = getSectionMd(lang, 'resources') ?? resources ?? '';
const html = renderMd(md, lang);
---
<Base title={`${ui.studyResources} — Visual-SLAM Roadmap`} lang={lang}>
  <main class="mx-auto max-w-5xl px-5 py-10">
    <p class="font-mono text-xs text-scan-500 tracking-[0.25em] uppercase">{ui.appendix}</p>
    <h1 class="font-display font-bold text-3xl sm:text-4xl mt-2">{ui.studyResources}</h1>
    <article class="prose prose-slate max-w-none mt-8 prose-headings:font-display prose-a:text-scan-500 prose-table:text-sm bg-paper/80 border border-paper-line p-6 sm:p-8" set:html={html} />
  </main>
</Base>
